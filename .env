# Copy to .env and fill in. .env is gitignored — never commit real values.

PORT=3000

# MyAnimeList API v2 — https://myanimelist.net/apiconfig
# Create an app to get a Client ID. The ID alone is enough for public/read-only
# data via the X-MAL-CLIENT-ID header; the secret is only needed for OAuth2
# user-list access, which this app does not implement yet.
#
# MAL sends no CORS headers, so this credential is used SERVER-SIDE ONLY.
# If MAL_CLIENT_ID is unset the app still works: MAL enrichment is skipped and
# Jikan (unofficial MAL mirror, no key required) covers characters/voice actors.
MAL_CLIENT_ID=31466

# Optional tuning
CACHE_TTL_DETAILS_MS=43200000
CACHE_TTL_LIST_MS=900000
JIKAN_MIN_INTERVAL_MS=400
